@model BookmarkDetailsViewModel
@using System.Text.Encodings.Web

@{
    ViewData["Title"] = Model.Title;
}

<section class="container py-5" style="max-width: 860px;">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between flex-wrap gap-3 mb-4">
                <div>
                    <span class="badge bg-@((Model.IsPublic ? "success" : "secondary"))">
                        @(Model.IsPublic ? "Public" : "Private")
                    </span>
                    <h1 class="h3 mt-2 mb-1">@Model.Title</h1>
                    <p class="text-muted mb-1">@Model.Description</p>
                    <small class="text-muted">
                        Added by <strong>@Model.AuthorName</strong> on @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <span class="ms-2">(Updated @Model.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm"))</span>
                        }
                    </small>
                </div>
                @if (Model.CanEdit)
                {
                    <div class="d-flex gap-2 ms-auto">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-pencil me-1"></i> Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-trash me-1"></i> Delete
                        </a>
                    </div>
                }
            </div>

            <div class="bookmark-media">
                @if (!string.IsNullOrWhiteSpace(Model.MediaContent.TextContent))
                {
                    var encoded = HtmlEncoder.Default.Encode(Model.MediaContent.TextContent);
                    var formatted = encoded.Replace("\n", "<br />");
                    <div class="mb-4">
                        <h5 class="fw-semibold">Notes</h5>
                        <div class="p-3 bg-light rounded border">
                            @Html.Raw(formatted)
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.MediaContent.ImageUrl))
                {
                    <div class="mb-4">
                        <h5 class="fw-semibold">Image</h5>
                        <img src="@Model.MediaContent.ImageUrl" alt="@Model.Title" class="img-fluid rounded shadow-sm" />
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.MediaContent.VideoEmbedUrl))
                {
                    <div class="mb-4">
                        <h5 class="fw-semibold">Video</h5>
                        <div class="ratio ratio-16x9 rounded overflow-hidden shadow-sm">
                            <iframe src="@Model.MediaContent.VideoEmbedUrl" title="Bookmark video player" allowfullscreen
                                    referrerpolicy="no-referrer" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                        </div>
                    </div>
                }

                @if (!Model.MediaContent.HasAnyMedia)
                {
                    <div class="alert alert-info d-flex align-items-center" role="alert">
                        <i class="bi bi-info-circle me-2"></i>
                        <div>This bookmark does not include additional media yet.</div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
